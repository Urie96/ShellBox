<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- HTTP 服务：监听 socket 需要 INTERNET；前台服务常驻需要 FOREGROUND_SERVICE +
         SPECIAL_USE 类型（不用 dataSync——Android 15+ 对 dataSync 有 6 小时/24 小时时限，会杀常驻服务）；
         Android 13+ 通知要 POST_NOTIFICATIONS（拒绝也不影响服务本身，只影响通知展示）；
         开机自启需要 RECEIVE_BOOT_COMPLETED -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 推送服务用 ConnectivityManager 监听网络切换（WiFi↔流量）触发立即重连；普通权限，安装即授 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 后台读取剪贴板需要：Android 10+ 后台启动 ghost activity 受 BAL 限制，
         授予「显示在其他应用上层」是官方列出的豁免条件之一（需用户在系统设置里手动开启） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".DemoApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="ShellBox"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault"
        tools:ignore="GoogleAppIndexingWarning">
        <activity android:name=".DemoActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 长按桌面图标出现的快捷方式：开启/关闭代理 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 快捷方式入口：无界面，执行代理切换后立即退出 -->
        <activity android:name=".ProxyShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- 剪贴板读取用透明幽灵 Activity：Android 10+ 读剪贴板必须有窗口焦点，
             前台服务没有；此 Activity 抢到焦点读完立即关闭（无动画、不进最近任务） -->
        <activity android:name=".ClipboardGhostActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ShellBox.Transparent" />

        <!-- HTTP 代理控制服务（前台服务，specialUse 类型：无 Android 15+ 的 dataSync 时限） -->
        <service android:name=".ProxyHttpService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local HTTP server for controlling Settings.Global http_proxy" />
        </service>

        <!-- 服务端推送（ntfy 订阅）：前台服务，specialUse 类型（无 dataSync 时限） -->
        <service android:name=".NtfyPushService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ntfy push notification subscriber (long-poll to self-hosted ntfy server)" />
        </service>

        <!-- 开机自动启动服务 + 重排保活闹钟（是否自启由应用内「自动保活」开关决定，见 DemoActivity） -->
        <receiver android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- 系统时间/时区/语言变化也是 Android 12+ 允许后台启动前台服务的豁免场景，
                     当成额外的「检查一次」时机（比如自动对时后） -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 保活看门狗闹钟接收器：每 15 分钟检查「自动保活开关为开但服务没跑」并拉起服务。
             用显式 Intent 的 PendingIntent 触发，不需要 intent-filter，也不用 exported -->
        <receiver android:name=".WatchdogReceiver"
            android:exported="false" />

        <!-- This provider is required by Shizuku, remove this if your app only supports Sui -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
