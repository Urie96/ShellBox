<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@android:id/text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/button_set_proxy"
            style="?android:borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="8dp"
            android:text="开启代理"
            android:textAllCaps="false"
            android:textColor="?android:colorAccent" />

        <Button
            android:id="@+id/button_clear_proxy"
            style="?android:borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="4dp"
            android:text="关闭代理"
            android:textAllCaps="false"
            android:textColor="?android:colorAccent" />

        <Button
            android:id="@+id/button_http_toggle"
            style="?android:borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="16dp"
            android:text="启动 HTTP 服务"
            android:textAllCaps="false"
            android:textColor="?android:colorAccent" />

        <CheckBox
            android:id="@+id/check_auto_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="自动保活 HTTP 服务（开机自启 + 被杀后自动重启）" />

        <Button
            android:id="@+id/button_overlay_permission"
            style="?android:borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="4dp"
            android:text="后台读取剪贴板：未授权（点此开启）"
            android:textAllCaps="false"
            android:textColor="?android:colorAccent" />

        <TextView
            android:id="@+id/text_http_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

        <!-- 服务端推送（ntfy）：手机长轮询订阅，NAS 上 curl 服务器即可发通知 -->
        <Button
            android:id="@+id/button_push_toggle"
            style="?android:borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="16dp"
            android:text="启动推送服务"
            android:textAllCaps="false"
            android:textColor="?android:colorAccent" />

        <Button
            android:id="@+id/button_push_config"
            style="?android:borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="4dp"
            android:text="推送设置（服务器 / topic / token）"
            android:textAllCaps="false"
            android:textColor="?android:colorAccent" />

        <Button
            android:id="@+id/button_push_test"
            style="?android:borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="4dp"
            android:text="发送测试推送"
            android:textAllCaps="false"
            android:textColor="?android:colorAccent" />

        <CheckBox
            android:id="@+id/check_push_auto_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="自动保活推送服务（开机自启 + 被杀后自动重启）" />

        <TextView
            android:id="@+id/text_push_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/text_watchdog_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

        <TextView
            android:id="@android:id/text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/text3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>
