.idea/
*.iml
.vscode/
*.hprof

# ---- Kotlin ----
.kotlin/

# ---- Devenv ----
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml
